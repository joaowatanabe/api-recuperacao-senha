meta {
  name: 9 - Reusar o mesmo código (uso único, 400)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/redefinir-senha
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}", 
    "codigo": "{{codigo}}", 
    "novaSenha": "OutraSenha#2026"
  }
}

assert {
  res.status: eq 400
}
