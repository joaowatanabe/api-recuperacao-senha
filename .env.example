PORT=3000
NODE_ENV=development

# Obrigatório em produção. Gere um valor longo e aleatório.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1h

DATABASE_PATH=./dados.db

# ethereal: caixa de teste (padrão; imprime o link de pré-visualização no console)
# smtp:     servidor SMTP real (preencha as variáveis SMTP_*)
# console:  imprime o código no console (somente com NODE_ENV=development)
MAIL_MODE=ethereal
MAIL_FROM="API Recuperação de Senha <nao-responda@exemplo.com>"

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
